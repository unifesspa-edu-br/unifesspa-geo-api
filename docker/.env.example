# Variáveis de ambiente para o docker-compose de desenvolvimento da API Geo.
# Copie este arquivo para .env e ajuste os valores conforme necessário:
#   cp .env.example .env

# PostgreSQL
POSTGRES_USER=uniplus
POSTGRES_PASSWORD=uniplus_dev
POSTGRES_DB=uniplus

# PostgreSQL Geo
GEO_DB_USER=uniplus_geo_app
GEO_DB_PASSWORD=uniplus_dev
GEO_DB_NAME=uniplus_geo

# PostgreSQL Geo — staging da DNE (issue #12). Banco DEDICADO (não um schema do
# uniplus_geo) para receber os 15 dumps brutos (Correios/IBGE) via `psql -f` sem
# nenhuma reescrita: os dumps qualificam "public"."tbl_cep_..." explicitamente, e
# só um "public" nativo os recebe de forma transparente. Ver docs/geo-etl-dataset-dne.md.
# Estes valores só documentam o que `docker/init-db.sql` provisiona — a API (rodada
# via `dotnet run`, fora deste compose) lê a connection string montada a partir
# deles em `ConnectionStrings:GeoStagingDb` (appsettings.Development.json).
GEO_STAGING_DB_USER=uniplus_geo_staging_app
GEO_STAGING_DB_PASSWORD=uniplus_dev
GEO_STAGING_DB_NAME=uniplus_geo_staging

# Keycloak (Identity Provider)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# gov.br como Identity Provider externo do Keycloak, quando usado no ambiente
# local de autenticação. NUNCA commitar valores reais.
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_ENV=staging
